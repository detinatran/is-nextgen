# Đường dẫn gốc khi deploy GitHub Pages (để trống nếu deploy ở domain riêng / Vercel)
NEXT_PUBLIC_BASE_PATH=

# Web App URL của Google Apps Script nhận dữ liệu form đăng ký (xem docs/google-apps-script.md)
NEXT_PUBLIC_REGISTER_ENDPOINT=

# (Tuỳ chọn) Link CSV của Google Sheet "Kết quả" đã Publish to web.
# Để trống thì trang đọc public/data/results.json
NEXT_PUBLIC_RESULTS_CSV_URL=
