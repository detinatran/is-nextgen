# Địa chỉ backend (NestJS). Production: https://nextgen.vnuis.edu.vn (nginx chuyển /api/ tới backend).
# Chạy thử ở máy: http://localhost:4000 hoặc địa chỉ backend local. Để trống thì form đăng ký và trang thi bị khoá.
NEXT_PUBLIC_API_URL=

# Mã cuộc thi trong cơ sở dữ liệu (mặc định ISNG-2026).
NEXT_PUBLIC_COMPETITION_CODE=

# Domain chính thức, dùng cho ảnh chia sẻ (Open Graph).
NEXT_PUBLIC_SITE_URL=

# (Tuỳ chọn) Link CSV của Google Sheet "Kết quả" đã Publish to web. Để trống thì đọc public/data/results.json.
NEXT_PUBLIC_RESULTS_CSV_URL=

# Đường dẫn gốc khi đặt site trong thư mục con (để trống khi chạy ở domain riêng).
NEXT_PUBLIC_BASE_PATH=

# (Cũ, dự phòng) Web App Google Apps Script nhận đăng ký khi không có backend – xem docs/google-apps-script.md.
NEXT_PUBLIC_REGISTER_ENDPOINT=
