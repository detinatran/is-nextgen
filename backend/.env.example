# Backend runtime configuration (development defaults shown).
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/isnextgen?schema=public

# Session cookie. Secure is forced on in production; set true when testing over https.
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
REAUTH_WINDOW_SECONDS=300

# Private media storage directory (mounted volume in Docker; never web-served).
MEDIA_STORAGE_DIR=./.data/media
UPLOAD_MAX_BYTES=500000000
VIDEO_MAX_DURATION_SECONDS=120

# Optional Redis accelerator. Redis is never a source of truth; loss must not imply data loss.
REDIS_URL=redis://localhost:6379

# Mail provider (SMTP). Empty SMTP_URL uses a console-capture mailer (dev/test only).
SMTP_URL=
MAIL_FROM="IS-NextGen <no-reply@isnextgen.local>"

# Internal fixture provisioning (FR-13..22 test support). MUST be disabled in production.
FIXTURES_ENABLED=true
FIXTURES_TOKEN=dev-fixtures-token

# Origins of the frontend allowed to call the API (comma-separated). Empty = CORS off.
CORS_ORIGINS=http://localhost:3002

# Swagger/OpenAPI (development or explicitly enabled).
SWAGGER_ENABLED=true

# Rate limiting (requests per window, per IP).
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=30

# Background workers.
TIMEOUT_SWEEP_INTERVAL_MS=10000
SCORING_POLL_INTERVAL_MS=2000
NOTIFICATION_POLL_INTERVAL_MS=2000

# Website thí sinh (dùng để tạo link trong email) và email liên hệ in cuối email.
PUBLIC_SITE_URL=https://nextgen.vnuis.edu.vn
CONTACT_EMAIL=nextgen@vnuis.edu.vn
# Production bắt buộc có SMTP_URL; đặt MAIL_CAPTURE=1 chỉ khi muốn bỏ qua (máy thử nghiệm).
MAIL_CAPTURE=

# Đứng sau nginx: tin header X-Forwarded-* để lấy IP thật và nhận diện https.
TRUST_PROXY=

# Ảnh chân dung tối đa (byte). Số lượt làm bài Vòng 1 của mỗi thí sinh.
PHOTO_MAX_BYTES=10000000
EXAM_ATTEMPT_QUOTA=1

# Lưu video thí sinh sang Google Drive (để trống thì giữ trên máy chủ). Lấy refresh token bằng scripts/drive-auth.py.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=NextGen Manager 2026 - Video thí sinh
GOOGLE_DRIVE_DELETE_LOCAL=true
GOOGLE_DRIVE_SYNC_INTERVAL_MS=60000
