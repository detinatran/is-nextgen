{
  "name": "is-nextgen-backend",
  "version": "0.1.0",
  "private": true,
  "description": "IS-NextGen Manager Challenge 2026 backend (candidate flow FR-13..FR-22)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "test": "jest --config test/jest-unit.config.js",
    "test:integration": "jest --config test/jest-integration.config.js --runInBand",
    "test:contract": "jest --config test/jest-contract.config.js --runInBand",
    "test:release-gate": "jest --config test/jest-release-gate.config.js --runInBand",
    "db:generate": "prisma generate",
    "admin:bootstrap": "node --env-file-if-exists=.env -r ts-node/register scripts/bootstrap-admin.ts",
    "admin:otp": "node --env-file-if-exists=.env -r ts-node/register scripts/local-admin-otp.ts",
    "test:admin": "jest --config test/jest-integration.config.js --runInBand --testPathPattern=admin.spec.ts",
    "db:deploy": "prisma migrate deploy",
    "openapi": "ts-node -P tsconfig.json scripts/generate-openapi.ts",
    "db:regression": "python ../database/test/run_validation.py"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "adm-zip": "^0.6.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "nodemailer": "10.0.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0"
  }
}
